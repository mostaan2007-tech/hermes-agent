# Caddy configuration for an office LAN.
#
#   office.local {            # <- change to the name your colleagues type
#       tls internal          # Caddy's own CA: run `caddy trust` once per PC
#
# To use a real certificate instead, drop `tls internal` and add your DNS
# (Caddy then needs port 80/443 reachable from the internet), or point `tls`
# at a company .crt/.key pair.
#
# Install:  cp Caddyfile /etc/caddy/Caddyfile && systemctl reload caddy

office.local {
    tls internal
    encode zstd gzip

    reverse_proxy 127.0.0.1:8000 {
        # the app trusts these headers only because uvicorn runs with
        # --proxy-headers --forwarded-allow-ips '*'
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up Host {host}
    }

    # uploads cap (mirror OFFICE_MAX_UPLOAD_MB)
    request_body {
        max_size 30MB
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # printed letters/quotes are opened in a new tab; keep them cache-free
    @dynamic {
        not path /static/*
    }
    header @dynamic Cache-Control "no-store"

    log {
        output file /var/log/caddy/office-crm.log {
            roll_size 20MiB
            roll_keep 5
        }
    }
}
