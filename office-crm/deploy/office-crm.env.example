# /etc/office-crm.env — environment for the Office CRM service.
# Copy to /etc/office-crm.env, adjust, then:  systemctl restart office-crm
#
# Every setting in app/config.py can be set here with the OFFICE_ prefix.

# --- where the data lives (database, uploads, backups, logs, secret key) -----
OFFICE_DATA_DIR=/var/lib/office-crm

# --- network ---------------------------------------------------------------
OFFICE_HOST=0.0.0.0
OFFICE_PORT=8000
# SQLite allows one writer at a time — keep this at 1 (the app is async enough).
OFFICE_WORKERS=1
# Set to 1 when the site is served over HTTPS (Caddy below does that).
OFFICE_COOKIE_SECURE=0

# --- identity shown in the UI and on printed letters ------------------------
OFFICE_APP_SHORT_NAME=دفتر یکپارچه
OFFICE_COMPANY_NAME=نام شرکت شما
OFFICE_COMPANY_ADDRESS=
OFFICE_COMPANY_PHONE=
OFFICE_COMPANY_EMAIL=
OFFICE_COMPANY_WEBSITE=
OFFICE_COMPANY_ECONOMIC_CODE=
OFFICE_COMPANY_NATIONAL_ID=
OFFICE_CURRENCY=تومان

# --- first run -------------------------------------------------------------
# Password for the built-in "admin" account when it is created. Change it after
# the first login. Leave empty to generate a random one (printed once on stdout).
OFFICE_ADMIN_PASSWORD=
# Load the demo dataset on first start (companies, letters, requests, ...).
OFFICE_DEMO_DATA=0

# --- behaviour -------------------------------------------------------------
# Nightly backups + reminder e-mails/SMS (0 disables the background scheduler).
OFFICE_SCHEDULER=1
OFFICE_NIGHTLY_BACKUP_ENABLED=1
OFFICE_BACKUP_HOUR=2
OFFICE_BACKUP_KEEP=14
OFFICE_TIMEZONE_OFFSET_MINUTES=210
OFFICE_ITEMS_PER_PAGE=25
OFFICE_MAX_UPLOAD_MB=25

# --- optional integrations (all off by default) -----------------------------
# OFFICE_SMTP_HOST=smtp.example.com
# OFFICE_SMTP_PORT=587
# OFFICE_SMTP_USER=
# OFFICE_SMTP_PASSWORD=
# OFFICE_SMTP_FROM=office@example.com
# OFFICE_EMAIL_NOTIFICATIONS=1
# OFFICE_KAVENEGAR_API_KEY=
# OFFICE_SMS_NOTIFICATIONS=1
