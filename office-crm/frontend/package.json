{
  "name": "office-crm-frontend-build",
  "private": true,
  "description": "Dev-time build tooling: Tailwind CSS + daisyUI, and vendored browser assets.",
  "scripts": {
    "build": "tailwindcss -i ./src/app.css -o ../app/static/css/app.css --minify",
    "watch": "tailwindcss -i ./src/app.css -o ../app/static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "daisyui": "^5.7.47"
  },
  "dependencies": {
    "htmx.org": "^2.0.7",
    "alpinejs": "^3.15.0",
    "jalaali-js": "^2.0.1",
    "jalalidatepicker": "^0.6.0",
    "vazirmatn": "^33.0.3"
  }
}
